########### Docker host ports ###########
CLIENT_PORT=5173
SERVER_PORT=5000
MONGO_PORT=27017

########### Client Configuration ###########
# Leave empty when using Nginx on the same origin so the browser calls /api.
VITE_API_BASE_URL=
VITE_PROXY_API_TARGET=http://server:5000

########### Server Configuration ###########
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

########### Database Configuration ###########
MONGO_INITDB_ROOT_USERNAME=hiredme
MONGO_INITDB_ROOT_PASSWORD=hiredme_password
MONGO_INITDB_DATABASE=hiredme
# Docker Compose builds the backend MONGODB_URI from the Mongo credentials above
# and the internal Docker hostname `mongo`.

########### Auth Configuration ###########
JWT_SECRET=replace_with_at_least_32_characters_for_docker
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Docker default backend URL exposed to the browser.
SERVER_PUBLIC_URL=http://localhost:5000
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

########### LLM Provider Configuration ###########
# Set one provider key below when USE_MOCK_AI=false.
USE_MOCK_AI=false
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
