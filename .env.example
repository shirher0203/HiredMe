########### Docker host ports ###########
CLIENT_PORT=5173
SERVER_PORT=5000
MONGO_PORT=27017

########### Client Configuration ###########
# Leave empty when using Nginx on the same origin so the browser calls /api.
VITE_API_BASE_URL=
VITE_PROXY_API_TARGET=http://server:5000

########### Server Configuration ###########
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

########### Database Configuration ###########
MONGO_INITDB_ROOT_USERNAME=hiredme
MONGO_INITDB_ROOT_PASSWORD=hiredme_password
MONGO_INITDB_DATABASE=hiredme
# Docker Compose builds the backend MONGODB_URI from the Mongo credentials above
# and the internal Docker hostname `mongo`.

########### Auth Configuration ###########
JWT_SECRET=replace_with_at_least_32_characters_for_docker

########### LLM Provider Configuration ###########
# Google Gemini is the only supported provider. Set GEMINI_API_KEY (or
# GOOGLE_GENERATIVE_AI_KEY) when USE_MOCK_AI=false.
USE_MOCK_AI=false
GOOGLE_GENERATIVE_AI_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Per-attempt AI request timeout and transient-failure retry budget.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# Total ceiling for one logical AI operation, covering transport retries and the
# validation retry together. This is what bounds how long a user waits.
AI_TOTAL_BUDGET_MS=45000
