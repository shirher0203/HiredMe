########### Server Configuration ###########
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

############ Database Configuration ###########
MONGODB_URI=mongodb://localhost:27017/hiredme

############ Auth Configuration ###########
JWT_SECRET=replace_with_at_least_32_characters
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to SERVER_PUBLIC_URL + /api/auth/google/callback.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
SERVER_PUBLIC_URL=http://localhost:5000

############ LLM Provider Configuration ###########
# Google Gemini is the only supported provider. Set GEMINI_API_KEY (or
# GOOGLE_GENERATIVE_AI_KEY) unless USE_MOCK_AI=true.
GOOGLE_GENERATIVE_AI_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

############ AI Reliability Configuration ###########
# Per-attempt request timeout, and how many times a transient provider failure
# (429/5xx/network) is retried.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
# Ceiling for one logical AI operation. This is the number that actually bounds
# how long a user waits: it covers every transport attempt AND the stricter-prompt
# validation retry, which share one deadline. Per-attempt timeouts are clamped to
# whatever is left of it, and retries stop once it is spent.
AI_TOTAL_BUDGET_MS=45000

############ Mock AI Configuration ###########
USE_MOCK_AI=false

############ AI Logging Configuration ###########
# DEBUG_AI emits timings and character counts only.
# DEBUG_AI_PAYLOADS additionally emits truncated prompt/output text and must
# stay off outside local debugging — prompts contain user CV and job content.
DEBUG_AI=false
DEBUG_AI_PAYLOADS=false
